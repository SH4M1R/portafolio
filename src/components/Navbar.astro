---
const whatsapp =
  'https://wa.me/51906974684?text=' +
  encodeURIComponent('Hola Juan Pablo, vi tu portafolio y me gustaría contactarte.');

const base =
  'rounded-lg px-3 py-2 text-sm font-medium transition-colors sm:px-4 sm:text-base';
---

<header class="sticky top-0 z-50 border-b border-line bg-ink-950/80 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-3 py-3 sm:px-6" aria-label="Principal">
    <a href="#sobre-mi" class="hidden font-display text-lg font-bold text-fog sm:block">
      Juan Pablo Inoñan Zegarra
    </a>

    <ul class="flex w-full items-center justify-between gap-1 sm:w-auto sm:justify-end sm:gap-2">
      <li>
        <a href="#sobre-mi" class:list={[base, 'text-mute hover:bg-ink-800 hover:text-fog']}>Sobre mí</a>
      </li>
      <li>
        <a href="#proyectos" class:list={[base, 'text-mute hover:bg-ink-800 hover:text-fog']}>Proyectos</a>
      </li>
      <li>
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[base, 'bg-violet-500 text-white hover:bg-violet-400']}
        >Contáctame</a>
      </li>
      <li>
        <a
          href="/CV-Inoñan.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class:list={[base, 'border border-blue-400/60 text-blue-300 hover:bg-blue-400/10']}
        >CV</a>
      </li>
    </ul>
  </nav>
</header>
